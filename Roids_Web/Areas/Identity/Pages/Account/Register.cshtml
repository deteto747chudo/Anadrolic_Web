@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        font-family: 'Poppins', sans-serif;
        margin: 0;
        padding: 0;
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        padding: 2.5rem;
        max-width: 420px;
        width: 100%;
        animation: fadeIn 0.6s ease-in-out;
    }

    .login-title {
        color: #333;
        font-weight: 600;
        text-align: center;
        margin-bottom: 15px;
    }

    .custom-input {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #ccc;
        width: 100%;
        font-size: 1rem;
        transition: all 0.3s ease-in-out;
    }

    .custom-input:focus {
        border-color: #2a5298;
        box-shadow: 0 0 5px rgba(42, 82, 152, 0.5);
        outline: none;
    }

    .btn-custom {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        border: none;
        padding: 12px;
        font-size: 1rem;
        border-radius: 8px;
        color: white;
        font-weight: bold;
        transition: all 0.3s ease-in-out;
        width: 100%;
        cursor: pointer;
    }

    .btn-custom:hover {
        background: linear-gradient(135deg, #1b3566, #254b87);
        transform: scale(1.02);
    }

    .login-footer {
        text-align: center;
        margin-top: 15px;
    }

    .login-footer a {
        color: #2a5298;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease-in-out;
    }

    .login-footer a:hover {
        text-decoration: underline;
        color: #1e3c72;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <h2 class="login-title">@ViewData["Title"]</h2>
        <hr />
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

            <!-- Email Field -->
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="custom-input" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Password Field -->
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="custom-input" autocomplete="new-password" placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="custom-input" autocomplete="new-password" placeholder="Confirm your password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="register-submit" type="submit" class="btn-custom">Register</button>

            <div class="login-footer">
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account? Sign In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
