@{
    ViewData["Title"] = "Home Page";
}

<style>
    .banner {
        position: relative;
        width: 100%;
        height: 1200px; /* Може да коригираш височината */
        background-image: url('/images/banner.jpg'); /* Смени с твоя снимка */
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); /* Полупрозрачен тъмен overlay */
    }

    .banner-content {
        position: relative;
        z-index: 2;
        max-width: 600px;
    }

    .banner h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .banner p {
        font-size: 1.2rem;
        margin-bottom: 20px;
    }

    .banner .btn {
        display: inline-block;
        padding: 12px 25px;
        background: red;
        color: white;
        text-decoration: none;
        font-size: 1rem;
        border-radius: 5px;
        transition: background 0.3s;
    }

    .banner .btn:hover {
        background: darkred;
    }
</style>

<div class="banner">
    <div class="banner-overlay"></div>
    <div class="banner-content">
        <h1>Добре дошли в нашия онлайн магазин!</h1>
        <p>Открийте най-добрите добавки за вашето здраве и спорт.</p>
        <a href="@Url.Action("Shop", "Products")" class="btn">Разгледай продукти</a>
    </div>
</div>