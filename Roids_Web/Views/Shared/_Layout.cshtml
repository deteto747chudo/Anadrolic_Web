<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roids_Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Roids_Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>
        /* Стилизиране на navbar-а, изолирано от другите CSS файлове */
        #navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1050;
            transition: transform 0.3s ease-in-out;
        }

            /* Скриване на navbar-а при скрол надолу */
            #navbar.navbar-hidden {
                transform: translateY(-100%);
            }

            /* Стилизиран тъмен navbar */
            #navbar .navbar {
                background: rgba(0, 0, 0, 0.8) !important; /* Тъмен фон с прозрачност */
                padding: 15px 0;
                transition: all 0.3s ease-in-out;
                box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
            }

            #navbar .navbar-brand, #navbar .nav-link {
                color: white !important;
                font-weight: bold;
                transition: color 0.3s ease-in-out;
            }

                #navbar .nav-link:hover {
                    color: #ff9800 !important;
                    transform: scale(1.05);
                }

            /* Падащо меню */
            #navbar .nav-item.dropdown:hover .dropdown-menu {
                display: block;
                margin-top: 0;
                opacity: 1;
                visibility: visible;
                transition: opacity 0.2s ease-in-out;
            }

            #navbar .dropdown-menu {
                background: rgba(0, 0, 0, 0.9);
                border: none;
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.2s ease-in-out;
            }

            #navbar .dropdown-item {
                color: white !important;
            }

                #navbar .dropdown-item:hover {
                    background: #ff9800 !important;
                    color: black !important;
                }

        /* Премахване на белите ръбове */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        /* Добавяне на място за navbar-а */
        body {
            padding-top: 80px;
        }
    </style>
</head>
<body>
    <header id="navbar">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Roids_Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Политика</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="productsDropdown" role="button" data-bs-toggle="dropdown">
                                Продукти
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="productsDropdown">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Всички продукти</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="1">Хормон на разтежа (HGH)</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="2">Стромба</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="3">Винстрол</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="4">Анавар</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="5">Болденон</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="6">Метан</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="7">Тестостерон</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="8">Тренболон</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="9">Мастерол</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Category" asp-route-id="10">Туринабол</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="FAQs" asp-action="Index">FAQ</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        let lastScrollTop = 0;
        const navbar = document.getElementById("navbar");

        window.addEventListener("scroll", function () {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (scrollTop > lastScrollTop) {
                // Скриване при скрол надолу
                navbar.classList.add("navbar-hidden");
            } else {
                // Показване при скрол нагоре
                navbar.classList.remove("navbar-hidden");
            }
            lastScrollTop = scrollTop;
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
